{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://lzlwhprzprxruiqqyqbw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "camp-mathos",
      "version": "0.1.0",
      "title": "Camp MathOs"
    },
    "tools": [
      {
        "name": "list_registrations",
        "title": "List camp sign-ups",
        "description": "List Camp MathOs sign-ups (campers and interest-list entries), newest first. Optionally filter by camp year or grade level.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "campYear": {
              "type": "integer",
              "description": "Camp year to filter by, e.g. 2026 or 2027. Omit for all years."
            },
            "gradeLevel": {
              "type": "string",
              "description": "Exact grade level value to filter by, e.g. '5th'."
            },
            "limit": {
              "type": "integer",
              "description": "How many rows to return. Defaults to 50, maximum 200."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "find_registration",
        "title": "Find a sign-up",
        "description": "Search Camp MathOs sign-ups by partial email, student name, or parent name.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Text to search for across email, student name, and parent name."
            }
          },
          "required": [
            "search"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "registration_stats",
        "title": "Sign-up statistics",
        "description": "Summarize Camp MathOs sign-ups: totals per camp year, per grade level, and how many arrived in the last 7 days.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "add_registration",
        "title": "Add a sign-up",
        "description": "Add someone to the Camp MathOs sign-up / interest list. Does not send a confirmation email.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "description": "Contact email address for the sign-up."
            },
            "campYear": {
              "type": "integer",
              "description": "Camp year. Defaults to 2027."
            },
            "studentFirstName": {
              "type": "string",
              "description": "Camper's first name."
            },
            "studentLastName": {
              "type": "string",
              "description": "Camper's last name."
            },
            "parentFirstName": {
              "type": "string",
              "description": "Parent or guardian first name."
            },
            "parentLastName": {
              "type": "string",
              "description": "Parent or guardian last name."
            },
            "phone": {
              "type": "string",
              "description": "Contact phone number."
            },
            "gradeLevel": {
              "type": "string",
              "description": "Camper's grade level, e.g. '5th'."
            }
          },
          "required": [
            "email"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
